# =============================================================================
# 锦越机械 JIN MACHINE — 后端环境配置
# =============================================================================
# cp .env.example .env 然后填入实际值
# =============================================================================

# 服务
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# 数据库 MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jinmachine
DB_USER=root
DB_PASSWORD=your_password
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=jinmachine-api

# 日志
LOG_LEVEL=info
LOG_DIR=./logs

# 安全
IDEMPOTENCY_TTL=86400
MAX_BODY_SIZE=100kb
MAX_BATCH_SIZE=100

# CORS — 前端地址
CORS_ORIGIN=http://localhost:8080
